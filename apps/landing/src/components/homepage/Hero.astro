<style is:global>
  /* Define the animation */
  @keyframes spark-float {
    0% {
      opacity: 0;
      transform: translate(0, 0) scale(0);
    }
    15% {
      opacity: var(--target-opacity, 0.8); /* Fade in quickly */
      transform: translate(calc(var(--tx) * 0.2), calc(var(--ty) * 0.2))
        scale(1);
    }
    80% {
      opacity: var(--target-opacity, 0.4); /* Fade out slowly */
    }
    100% {
      opacity: 0;
      transform: translate(var(--tx), var(--ty)) scale(0);
    }
  }

  .animate-spark {
    animation-name: spark-float;
    animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1); /* Ease-in-out */
    animation-iteration-count: infinite;
  }
</style>

<script>
  function initSparks() {
    const container = document.getElementById("particles-container");
    if (!container) return;

    // Configuration
    const particleCount = 100; // Number of sparks
    const colors = [
      "bg-lemon-lime",
      "bg-lime-moss",
      "bg-white",
      "bg-lemon-lime",
    ]; // Added lemon-lime twice to make it dominant

    // Clear existing (in case of re-renders)
    container.innerHTML = "";

    for (let i = 0; i < particleCount; i++) {
      const spark = document.createElement("div");

      // Randomize Properties
      const size =
        Math.random() < 0.6
          ? "w-0.5 h-0.5"
          : Math.random() < 0.9
            ? "w-1 h-1"
            : "w-1.5 h-1.5"; // mostly small, some medium, few large
      const color = colors[Math.floor(Math.random() * colors.length)];
      const left = Math.floor(Math.random() * 100);
      const top = Math.floor(Math.random() * 100);

      // Random movement vectors (between -100px and 100px)
      const tx = (Math.random() - 0.5) * 200;
      const ty = (Math.random() - 0.5) * 150; // slightly less vertical movement to keep them floating

      // Random timings
      const duration = 3 + Math.random() * 5; // Between 3s and 8s
      const delay = Math.random() * -5; // Negative delay ensures some are already visible on load
      const opacity = 0.4 + Math.random() * 0.6; // Opacity between 0.4 and 1.0

      // Apply Classes
      spark.className = `absolute rounded-full opacity-0 animate-spark ${size} ${color}`;

      // Apply CSS Variables for the animation keyframes
      spark.style.left = `${left}%`;
      spark.style.top = `${top}%`;
      spark.style.setProperty("--tx", `${tx}px`);
      spark.style.setProperty("--ty", `${ty}px`);
      spark.style.setProperty("--target-opacity", `${opacity}`);
      spark.style.animationDuration = `${duration}s`;
      spark.style.animationDelay = `${delay}s`;

      container.appendChild(spark);
    }
  }

  // Run on load
  initSparks();

  // If you use View Transitions in Astro, uncomment the line below:
  document.addEventListener("astro:page-load", initSparks);
</script>

