---
const docRows = [
  { label: 'RUC', value: '20512345678' },
  { label: 'TIPO', value: 'FACTURA' },
  { label: 'SERIE', value: 'F001-00482' },
  { label: 'EMISIÓN', value: '02/06/2026' },
  { label: 'SUBTOTAL', value: 'S/ 690.00' },
  { label: 'IGV (18%)', value: 'S/ 124.20' },
  { label: 'TOTAL', value: 'S/ 814.20', strong: true },
]
---

<section class="ledger-lines relative overflow-hidden pt-16">
  <div
    class="pointer-events-none absolute -top-32 right-[-10%] h-96 w-96 rounded-full bg-lime/10 blur-[140px]"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto grid max-w-6xl gap-14 px-5 pt-16 pb-20 sm:px-8 lg:grid-cols-12 lg:gap-8 lg:pt-24 lg:pb-28">
    <div class="lg:col-span-7 lg:pr-8">
      <p class="kicker mb-8" data-anim="hero-kicker">
        [ Alfa privada — Perú ]
      </p>

      <h1 class="font-display text-[clamp(2.75rem,8vw,5.25rem)] leading-[1.02] font-medium tracking-tight text-paper">
        <span class="block overflow-hidden">
          <span class="block" data-anim="hero-line">Del correo</span>
        </span>
        <span class="block overflow-hidden">
          <span class="block" data-anim="hero-line">
            al <em class="font-light text-lime italic">CSV</em>,
          </span>
        </span>
        <span class="block overflow-hidden">
          <span class="block" data-anim="hero-line">sin tipear nada.</span>
        </span>
      </h1>

      <p
        class="mt-8 max-w-xl text-lg leading-relaxed text-paper-dim"
        data-anim="hero-sub"
      >
        Ticka recibe los comprobantes de tus clientes, extrae los datos de cada
        XML o PDF y te entrega un CSV con las columnas exactas de tu sistema
        contable. Hecho para estudios contables en el Perú.
      </p>

      <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center" data-anim="hero-cta">
        <a
          href="#contacto"
          class="border border-lime bg-lime px-7 py-4 text-center font-mono text-sm font-semibold tracking-[0.14em] text-ink-950 uppercase transition-colors duration-300 hover:bg-transparent hover:text-lime"
        >
          Unirme al alfa
        </a>
        <a
          href="/blog/"
          class="draw-link self-center py-2 font-mono text-sm tracking-[0.08em] text-paper-dim uppercase hover:text-paper"
        >
          Ver novedades →
        </a>
      </div>

      <p class="mt-8 font-mono text-xs tracking-[0.12em] text-paper-mute" data-anim="hero-note">
        v0.x — en construcción con estudios contables reales
      </p>
    </div>

    <div class="lg:col-span-5" data-anim="hero-doc">
      <div class="relative border border-moss/25 bg-ink-900/90">
        <div
          class="pointer-events-none absolute inset-x-0 top-0 h-10 bg-gradient-to-b from-lime/15 to-transparent opacity-0"
          data-anim="doc-scan"
          aria-hidden="true"
        >
        </div>

        <div class="flex items-center justify-between gap-3 border-b border-moss/25 px-5 py-3">
          <span class="truncate font-mono text-xs text-moss">
            ws-estudio-garcia@ticka.pe
          </span>
          <span class="shrink-0 font-mono text-[10px] tracking-[0.14em] text-paper-mute uppercase">
            Recibido 09:41
          </span>
        </div>

        <div class="border-b border-moss/25 px-5 py-3">
          <span class="font-mono text-xs text-paper-dim">
            ↳ factura-f001-00482.xml
          </span>
        </div>

        <dl class="px-5 py-4">
          {
            docRows.map((row) => (
              <div
                class:list={[
                  'flex items-baseline justify-between gap-4 py-1.5',
                  row.strong && 'mt-1.5 border-t border-moss/25 pt-3',
                ]}
                data-anim="doc-row"
              >
                <dt class="font-mono text-xs tracking-[0.14em] text-paper-mute uppercase">
                  {row.label}
                </dt>
                <dd
                  class:list={[
                    'font-mono text-sm',
                    row.strong ? 'font-semibold text-lime' : 'text-paper',
                  ]}
                >
                  {row.value}
                </dd>
              </div>
            ))
          }
        </dl>

        <div class="flex items-center justify-between border-t border-moss/25 px-5 py-4">
          <span class="stamp -rotate-2 text-xs text-lime" data-anim="doc-stamp">
            ✓ Aprobado
          </span>
          <span class="font-mono text-xs text-paper-dim" data-anim="doc-export">
            → listo para exportar<span class="animate-pulse text-lime">_</span>
          </span>
        </div>
      </div>

      <p class="mt-4 text-center font-mono text-[11px] tracking-[0.1em] text-paper-mute">
        Procesado por Ticka — sin intervención manual
      </p>
    </div>
  </div>
</section>
