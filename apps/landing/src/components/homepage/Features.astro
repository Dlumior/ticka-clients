---
const features = [
  {
    icon: "✉️",
    title: "Email único",
    description:
      "Recibe un correo exclusivo para reenviar todas tus facturas. En el futuro, solo enlaza tu cuenta.",
    gradient: "from-lemon-lime/20 to-lime-moss/20",
  },
  {
    icon: "🤖",
    title: "Extracción automática",
    description:
      "Soporte para XML ahora. OCR e IA próximamente para máxima precisión.",
    gradient: "from-lime-moss/20 to-lemon-lime/20",
  },
  {
    icon: "📊",
    title: "Exporta a Excel",
    description:
      "Descarga todos tus datos organizados y listos para trabajar en Excel.",
    gradient: "from-lemon-lime/20 to-lime-moss/20",
  },
  {
    icon: "👥",
    title: "Colaboración",
    description:
      "Agrupa todas las facturas de tu organización en un solo lugar centralizado.",
    gradient: "from-lime-moss/20 to-lemon-lime/20",
  },
];
---

<section id="caracteristicas" class="relative py-32 overflow-hidden">
  <div
    class="absolute inset-0 bg-gradient-to-b from-charcoal-brown via-charcoal-brown-2 to-charcoal-brown"
  >
  </div>

  <!-- Background Effects -->
  <div
    class="absolute top-1/2 left-0 w-96 h-96 bg-lime-moss rounded-full blur-3xl opacity-10"
  >
  </div>
  <div
    class="absolute bottom-0 right-0 w-96 h-96 bg-lemon-lime rounded-full blur-3xl opacity-10"
  >
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-20">
      <div
        class="inline-block mb-4 px-4 py-2 bg-dark-khaki-2/50 backdrop-blur-sm border border-lime-moss/30 rounded-full"
      >
        <span class="text-lime-moss text-sm font-semibold"
          >✨ Características</span
        >
      </div>
      <h2 class="text-5xl md:text-6xl font-black mb-6">
        <span
          class="bg-gradient-to-r from-white to-gray-400 bg-clip-text text-transparent"
        >
          Todo lo que necesitas
        </span>
      </h2>
      <p class="text-xl text-gray-400 max-w-2xl mx-auto">
        Herramientas poderosas para gestionar tus facturas de forma eficiente
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        features.map((feature, index) => (
          <div class="group relative">
            <div
              class={`absolute inset-0 bg-gradient-to-br ${feature.gradient} rounded-2xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500`}
            />
            <div class="relative bg-dark-khaki-2/50 backdrop-blur-xl rounded-2xl p-8 border border-lime-moss/20 hover:border-lime-moss/40 transition-all duration-300 transform hover:scale-105 hover:-translate-y-2 h-full">
              <div class="text-6xl mb-6 transform group-hover:scale-110 transition-transform duration-300">
                {feature.icon}
              </div>
              <h3 class="text-2xl font-bold mb-4 bg-gradient-to-r from-white to-gray-300 bg-clip-text text-transparent">
                {feature.title}
              </h3>
              <p class="text-gray-400 leading-relaxed">{feature.description}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
