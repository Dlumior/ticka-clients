---

---

<section id="suscribirse" class="relative py-32 overflow-hidden">
  <div
    class="absolute inset-0 bg-gradient-to-br from-dark-khaki via-dark-khaki-2 to-charcoal-brown-2"
  >
  </div>

  <!-- Animated Background -->
  <div class="absolute inset-0">
    <div
      class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(circle_at_30%_20%,rgba(192,216,32,0.15),transparent_50%)]"
    >
    </div>
    <div
      class="absolute top-0 right-0 w-full h-full bg-[radial-gradient(circle_at_70%_80%,rgba(170,180,74,0.15),transparent_50%)]"
    >
    </div>
  </div>

  <!-- Grid Pattern -->
  <div
    class="absolute inset-0 bg-[linear-gradient(rgba(192,216,32,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(192,216,32,0.03)_1px,transparent_1px)] bg-[size:50px_50px]"
  >
  </div>

  <div class="relative p-10">
    <div
      class="absolute inset-0 bg-gradient-to-r from-lemon-lime/20 to-lime-moss/20 rounded-3xl blur-2xl"
    >
    </div>
    <div
      class="relative bg-dark-khaki-2/60 backdrop-blur-2xl rounded-3xl p-10 md:p-12 border border-lime-moss/30 shadow-2xl"
    >
      <form class="space-y-6" id="subscribe-form" method="POST">
        <!-- Hidden field to store IP (will be filled by JavaScript) -->
        <input type="hidden" name="ipAddress" id="ipAddress" />

        <div class="grid md:grid-cols-2 gap-6">
          <div>
            <label
              class="block text-sm font-semibold text-gray-300 mb-2"
              for="fullName"
            >
              Nombre completo *
            </label>
            <input
              id="fullName"
              name="fullName"
              type="text"
              placeholder="Juan Pérez"
              class="w-full px-6 py-4 rounded-xl bg-charcoal-brown/50 border-2 border-lime-moss/20 focus:border-lemon-lime focus:outline-none text-white placeholder-gray-500 transition-all duration-300"
              required
            />
          </div>
          <div>
            <label
              class="block text-sm font-semibold text-gray-300 mb-2"
              for="email"
            >
              Email *
            </label>
            <input
              id="email"
              name="email"
              type="email"
              placeholder="tu@email.com"
              class="w-full px-6 py-4 rounded-xl bg-charcoal-brown/50 border-2 border-lime-moss/20 focus:border-lemon-lime focus:outline-none text-white placeholder-gray-500 transition-all duration-300"
              required
            />
          </div>
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-300 mb-2">
            ¿Qué problemas de la gestión de documentos quieres resolver? (Elige
            todos los que apliquen)
          </label>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <label
              class="flex items-center space-x-3 p-3 rounded-lg bg-charcoal-brown/30 hover:bg-charcoal-brown/50 cursor-pointer transition-colors"
            >
              <input
                type="checkbox"
                name="problems[]"
                value="Reducir errores de tipeo y transcripción"
                class="rounded border-lime-moss text-lemon-lime focus:ring-lemon-lime bg-charcoal-brown"
              />
              <span class="text-gray-300">
                Minimizar errores de tipeo y datos incorrectos
              </span>
            </label>

            <label
              class="flex items-center space-x-3 p-3 rounded-lg bg-charcoal-brown/30 hover:bg-charcoal-brown/50 cursor-pointer transition-colors"
            >
              <input
                type="checkbox"
                name="problems[]"
                value="Acelerar el proceso de llenado manual de datos"
                class="rounded border-lime-moss text-lemon-lime focus:ring-lemon-lime bg-charcoal-brown"
              />
              <span class="text-gray-300">
                Acelerar el llenado de datos y ahorrar tiempo
              </span>
            </label>

            <label
              class="flex items-center space-x-3 p-3 rounded-lg bg-charcoal-brown/30 hover:bg-charcoal-brown/50 cursor-pointer transition-colors"
            >
              <input
                type="checkbox"
                name="problems[]"
                value="Organización y dificultad para encontrar documentos"
                class="rounded border-lime-moss text-lemon-lime focus:ring-lemon-lime bg-charcoal-brown"
              />
              <span class="text-gray-300">
                Mejorar la organización y búsqueda de facturas
              </span>
            </label>

            <label
              class="flex items-center space-x-3 p-3 rounded-lg bg-charcoal-brown/30 hover:bg-charcoal-brown/50 cursor-pointer transition-colors"
            >
              <input
                type="checkbox"
                name="problems[]"
                value="Dificultad para exportar/sincronizar con el sistema contable"
                class="rounded border-lime-moss text-lemon-lime focus:ring-lemon-lime bg-charcoal-brown"
              />
              <span class="text-gray-300">
                Simplificar la exportación a mi software contable
              </span>
            </label>
          </div>
        </div>

        <div>
          <label
            for="company"
            class="block text-sm font-semibold text-gray-300 mb-2"
          >
            ¿En qué industria trabajas? (opcional)
          </label>
          <input
            id="company"
            name="company"
            type="text"
            placeholder="Ej: Tech, Marketing, Educación, etc."
            class="w-full px-6 py-4 rounded-xl bg-charcoal-brown/50 border-2 border-lime-moss/20 focus:border-lemon-lime focus:outline-none text-white placeholder-gray-500 transition-all duration-300"
          />
        </div>

        <div>
          <label
            for="referralSource"
            class="block text-sm font-semibold text-gray-300 mb-2"
          >
            ¿Cómo nos encontraste?
          </label>
          <select
            id="referralSource"
            name="referralSource"
            class="w-full px-6 py-4 rounded-xl bg-charcoal-brown/50 border-2 border-lime-moss/20 focus:border-lemon-lime focus:outline-none text-white placeholder-gray-500 transition-all duration-300"
            required
          >
            <option value="" class="bg-charcoal-brown"
              >Selecciona una opción</option
            >
            <option value="Redes Sociales" class="bg-charcoal-brown"
              >Redes Sociales (Twitter/LinkedIn)</option
            >
            <option value="Buscador" class="bg-charcoal-brown"
              >Buscador (Google, etc.)</option
            >
            <option value="Recomendación" class="bg-charcoal-brown"
              >Recomendación de un colega</option
            >
            <option value="Foro" class="bg-charcoal-brown"
              >Foro o comunidad online</option
            >
            <option value="Evento" class="bg-charcoal-brown"
              >Evento o conferencia</option
            >
            <option value="Otro" class="bg-charcoal-brown">Otro</option>
          </select>
        </div>

        <button
          type="submit"
          class="group relative w-full bg-gradient-to-r from-lemon-lime to-lime-moss text-charcoal-brown px-8 py-5 rounded-xl text-lg font-black hover:shadow-2xl hover:shadow-lemon-lime/50 transition-all duration-300 transform hover:scale-[1.02] overflow-hidden"
          id="submit-button"
        >
          <span class="relative z-10 flex items-center justify-center gap-2">
            <span id="button-text">Únete a la lista de espera</span>
            <svg
              class="w-5 h-5 transform group-hover:translate-x-1 transition-transform"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="3"
                d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </span>
          <div
            class="absolute inset-0 bg-white/20 transform scale-x-0 group-hover:scale-x-100 transition-transform origin-left duration-300"
          >
          </div>
        </button>
      </form>

      <!-- Success Message (hidden by default) -->
      <div
        id="success-message"
        class="hidden mt-6 p-6 bg-gradient-to-r from-green-900/30 to-emerald-900/30 border border-green-500/50 rounded-xl text-center backdrop-blur-sm"
      >
        <div
          class="inline-flex items-center justify-center w-16 h-16 bg-green-900/50 rounded-full mb-4"
        >
          <svg
            class="w-8 h-8 text-green-300"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M5 13l4 4L19 7"></path>
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-white mb-2">
          ¡Gracias por unirte! 🎉
        </h3>
        <p class="text-gray-300 mb-4">
          Estamos construyendo algo especial y serás de los primeros en saberlo.
        </p>
      </div>

      <!-- Error Message (hidden by default) -->
      <div
        id="error-message"
        class="hidden mt-6 p-4 bg-red-900/30 border border-red-500/50 rounded-xl text-center"
      >
        <p class="text-red-300 font-semibold" id="error-text">
          Hubo un error. Por favor, inténtalo de nuevo.
        </p>
      </div>

      <div class="mt-6 text-center">
        <p
          class="text-gray-400 text-sm flex items-center justify-center gap-2 flex-wrap"
        >
          <span class="text-lime-moss">✓</span>
          Acceso anticipado al MVP
          <span class="text-lime-moss">✓</span>
          Encuestas exclusivas
          <span class="text-lime-moss">✓</span>
          Sin spam, 100% privado
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  // Your Google Apps Script Web App URL (REPLACE THIS)
  const GOOGLE_SCRIPT_URL =
    "https://script.google.com/macros/s/AKfycbxXinNpDRDALF4d3b2rfscjtrM0mcYjwfMQa5yFUdVJ1Fke2T_z71vyQuzpmEAJK4fj3A/exec";

  // Get user's IP address
  async function getUserIP() {
    try {
      const response = await fetch("https://api.ipify.org?format=json");
      const data = await response.json();
      return data.ip;
    } catch (error) {
      console.warn("Could not get IP address:", error);
      return "Unknown";
    }
  }

  // Handle form submission
  document.addEventListener("DOMContentLoaded", async function () {
    const form = document.getElementById("subscribe-form");
    const submitButton = document.getElementById("submit-button");
    const buttonText = document.getElementById("button-text");
    const successMessage = document.getElementById("success-message");
    const errorMessage = document.getElementById("error-message");
    const errorText = document.getElementById("error-text");

    // Get and store IP address
    const userIP = await getUserIP();
    document.getElementById("ipAddress").value = userIP;

    form.addEventListener("submit", async function (e) {
      e.preventDefault();

      // Disable button and show loading
      submitButton.disabled = true;
      buttonText.textContent = "Enviando...";
      submitButton.classList.add("opacity-75");

      // Hide previous messages
      successMessage.classList.add("hidden");
      errorMessage.classList.add("hidden");

      // Prepare form data
      const formData = new FormData(form);
      const data = {
        fullName: formData.get("fullName"),
        email: formData.get("email"),
        company: formData.get("company"),
        referralSource: formData.get("referralSource"),
        ipAddress: userIP,
      };

      // Process checkboxes (interests)
      const interests = [];
      document
        .querySelectorAll('input[name="interests[]"]:checked')
        .forEach((checkbox) => {
          interests.push(checkbox.value);
        });
      data.interests = interests;

      try {
        // Send to Google Sheets
        const response = await fetch(GOOGLE_SCRIPT_URL, {
          method: "POST",
          mode: "no-cors", // Important for Google Apps Script
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify(data),
        });

        // Note: With 'no-cors' we can't read the response, but we know it was sent
        // Show success message
        successMessage.classList.remove("hidden");
        form.classList.add("hidden");

        // Optional: Track in localStorage to prevent duplicate submissions
        localStorage.setItem("tickape_subscribed", "true");

        // Optional: Send to analytics
        if (typeof gtag !== "undefined") {
          gtag("event", "waitlist_signup", {
            event_category: "engagement",
            event_label: "Google Sheets Form",
          });
        }
      } catch (error) {
        console.error("Submission error:", error);

        // Show error message
        errorText.textContent =
          "Error de conexión. Por favor, recarga la página e inténtalo de nuevo.";
        errorMessage.classList.remove("hidden");

        // Re-enable button
        submitButton.disabled = false;
        buttonText.textContent = "Únete a la lista de espera";
        submitButton.classList.remove("opacity-75");
      }
    });
  });
</script>
