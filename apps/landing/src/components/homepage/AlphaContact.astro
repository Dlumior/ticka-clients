---
import { CONTACT_FORM_URL } from '../../consts'

const perks = [
  'Acceso anticipado sin costo durante el alfa',
  'Influencia directa sobre lo que construimos',
  'Soporte cercano, en tu idioma: RUC, IGV, PLE',
]
---

<section id="contacto" class="ledger-lines relative scroll-mt-16 overflow-hidden py-24 lg:py-32">
  <div
    class="pointer-events-none absolute -bottom-40 left-[-10%] h-96 w-96 rounded-full bg-lime/8 blur-[140px]"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto grid max-w-6xl gap-14 px-5 sm:px-8 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-6">
      <p class="kicker mb-6" data-anim="reveal">[ 03 — Alfa privada ]</p>
      <h2
        class="font-display text-4xl leading-[1.08] font-medium tracking-tight text-paper sm:text-5xl"
        data-anim="reveal"
      >
        Ticka está en <em class="text-lime italic">alfa</em>. Y es a propósito.
      </h2>
      <p class="mt-6 max-w-lg text-lg leading-relaxed text-paper-dim" data-anim="reveal">
        Estamos construyendo Ticka junto a un grupo pequeño de estudios
        contables en el Perú. Cada flujo — de la bandeja de entrada al CSV — se
        afina con comprobantes y casos reales. Si quieres ser parte, déjanos
        tus datos y te escribimos para coordinar tu acceso.
      </p>

      <ul class="mt-10 space-y-4" data-anim="reveal">
        {
          perks.map((perk) => (
            <li class="flex items-baseline gap-3 text-[15px] text-paper-dim">
              <span class="font-mono text-lime">✓</span>
              {perk}
            </li>
          ))
        }
      </ul>

      <p class="mt-10 font-mono text-xs tracking-[0.12em] text-paper-mute" data-anim="reveal">
        Cupos limitados — respondemos cada solicitud personalmente.
      </p>
    </div>

    <div class="lg:col-span-6" data-anim="contact-form">
      <div class="border border-moss/25 bg-ink-900/90">
        <div class="flex items-center justify-between border-b border-moss/25 px-6 py-4">
          <span class="font-mono text-xs tracking-[0.2em] text-moss uppercase">
            Solicitud de acceso
          </span>
          <span class="stamp rotate-2 text-[10px] text-lime">Alfa</span>
        </div>

        <form id="contact-form" class="space-y-7 px-6 py-8" method="POST">
          <input type="hidden" name="ipAddress" id="ipAddress" />

          <div>
            <label
              for="fullName"
              class="mb-2 block font-mono text-xs tracking-[0.16em] text-paper-dim uppercase"
            >
              Nombre completo *
            </label>
            <input
              id="fullName"
              name="fullName"
              type="text"
              required
              autocomplete="name"
              placeholder="María Quispe"
              class="w-full border-0 border-b border-moss/30 bg-transparent px-0 py-2.5 text-paper placeholder-paper-mute/60 transition-colors duration-300 focus:border-lime focus:ring-0 focus:outline-none"
            />
          </div>

          <div>
            <label
              for="email"
              class="mb-2 block font-mono text-xs tracking-[0.16em] text-paper-dim uppercase"
            >
              Correo *
            </label>
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder="maria@estudiocontable.pe"
              class="w-full border-0 border-b border-moss/30 bg-transparent px-0 py-2.5 text-paper placeholder-paper-mute/60 transition-colors duration-300 focus:border-lime focus:ring-0 focus:outline-none"
            />
          </div>

          <div>
            <label
              for="company"
              class="mb-2 block font-mono text-xs tracking-[0.16em] text-paper-dim uppercase"
            >
              Estudio o empresa <span class="text-paper-mute">(opcional)</span>
            </label>
            <input
              id="company"
              name="company"
              type="text"
              autocomplete="organization"
              placeholder="Estudio Quispe & Asociados"
              class="w-full border-0 border-b border-moss/30 bg-transparent px-0 py-2.5 text-paper placeholder-paper-mute/60 transition-colors duration-300 focus:border-lime focus:ring-0 focus:outline-none"
            />
          </div>

          <div>
            <label
              for="referralSource"
              class="mb-2 block font-mono text-xs tracking-[0.16em] text-paper-dim uppercase"
            >
              ¿Cómo nos encontraste? *
            </label>
            <select
              id="referralSource"
              name="referralSource"
              required
              class="w-full border-0 border-b border-moss/30 bg-transparent px-0 py-2.5 text-paper transition-colors duration-300 focus:border-lime focus:ring-0 focus:outline-none"
            >
              <option value="" class="bg-ink-900">Selecciona una opción</option>
              <option value="Redes Sociales" class="bg-ink-900">Redes sociales</option>
              <option value="Buscador" class="bg-ink-900">Buscador (Google, etc.)</option>
              <option value="Recomendación" class="bg-ink-900">Recomendación de un colega</option>
              <option value="Foro" class="bg-ink-900">Foro o comunidad</option>
              <option value="Evento" class="bg-ink-900">Evento o conferencia</option>
              <option value="Otro" class="bg-ink-900">Otro</option>
            </select>
          </div>

          <button
            id="contact-submit"
            type="submit"
            class="w-full border border-lime bg-lime px-6 py-4 font-mono text-sm font-semibold tracking-[0.14em] text-ink-950 uppercase transition-colors duration-300 hover:bg-transparent hover:text-lime disabled:cursor-wait disabled:opacity-60"
          >
            <span id="contact-submit-label">Solicitar acceso →</span>
          </button>

          <p class="text-center font-mono text-[11px] tracking-[0.08em] text-paper-mute">
            Te respondemos por correo. Sin spam, nunca.
          </p>
        </form>

        <div id="contact-success" class="hidden px-6 py-12 text-center">
          <p class="stamp mx-auto -rotate-2 text-sm text-lime">✓ Solicitud recibida</p>
          <h3 class="mt-6 font-display text-2xl font-medium text-paper">
            Gracias por escribirnos.
          </h3>
          <p class="mt-3 text-[15px] leading-relaxed text-paper-dim">
            Te contactaremos pronto para coordinar tu acceso al alfa de Ticka.
          </p>
        </div>

        <div id="contact-error" class="hidden border-t border-moss/25 px-6 py-4 text-center">
          <p class="font-mono text-xs text-red-400">
            Hubo un error al enviar. Por favor, inténtalo de nuevo.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ CONTACT_FORM_URL }}>
  async function getUserIP() {
    try {
      const response = await fetch('https://api.ipify.org?format=json')
      const data = await response.json()
      return data.ip
    } catch {
      return 'Unknown'
    }
  }

  function initContactForm() {
    const form = document.getElementById('contact-form')
    const submit = document.getElementById('contact-submit')
    const label = document.getElementById('contact-submit-label')
    const success = document.getElementById('contact-success')
    const error = document.getElementById('contact-error')
    if (!form || !submit || !label || !success || !error) return

    getUserIP().then((ip) => {
      const field = document.getElementById('ipAddress')
      if (field) field.value = ip
    })

    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      submit.disabled = true
      label.textContent = 'Enviando…'
      error.classList.add('hidden')

      const formData = new FormData(form)
      const data = {
        fullName: formData.get('fullName'),
        email: formData.get('email'),
        company: formData.get('company'),
        referralSource: formData.get('referralSource'),
        ipAddress: formData.get('ipAddress'),
      }

      try {
        // no-cors: Google Apps Script does not return readable CORS responses
        await fetch(CONTACT_FORM_URL, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        })
        form.classList.add('hidden')
        success.classList.remove('hidden')
        localStorage.setItem('tickape_subscribed', 'true')
      } catch {
        error.classList.remove('hidden')
        submit.disabled = false
        label.textContent = 'Solicitar acceso →'
      }
    })
  }

  initContactForm()
  document.addEventListener('astro:page-load', initContactForm)
</script>
