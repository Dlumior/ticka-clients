---
const benefits = [
  {
    icon: "⚡",
    title: "Ahorro de tiempo",
    description: "Reduce horas de trabajo manual a minutos automáticos.",
    stat: "90%",
    statLabel: "Menos tiempo",
  },
  {
    icon: "🎯",
    title: "Menos procesos manuales",
    description: "Automatiza tareas repetitivas y enfócate en lo importante.",
    stat: "100%",
    statLabel: "Automatizado",
  },
  {
    icon: "✅",
    title: "Reducción de errores",
    description: "Eliminación de errores humanos en la transcripción de datos.",
    stat: "99%",
    statLabel: "Precisión",
  },
];
---

<section id="beneficios" class="relative py-32 overflow-hidden">
  <div
    class="absolute inset-0 bg-gradient-to-b from-charcoal-brown-2 via-dark-khaki-2 to-charcoal-brown"
  >
  </div>

  <!-- Glowing Effects -->
  <div
    class="absolute top-1/4 left-1/4 w-96 h-96 bg-lemon-lime rounded-full blur-3xl opacity-10 glow-pulse"
  >
  </div>
  <div
    class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-lime-moss rounded-full blur-3xl opacity-10 glow-pulse"
    style="animation-delay: 2s;"
  >
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-20">
      <div
        class="inline-block mb-4 px-4 py-2 bg-dark-khaki-2/50 backdrop-blur-sm border border-lime-moss/30 rounded-full"
      >
        <span class="text-lime-moss text-sm font-semibold font-sans"
          >💎 Beneficios</span
        >
      </div>
      <h2 class="text-5xl md:text-6xl font-serif font-bold mb-6">
        <span
          class="bg-gradient-to-r from-white to-gray-400 bg-clip-text text-transparent"
        >
          Beneficios que marcan
        </span>
        <br />
        <span
          class="bg-gradient-to-r from-lemon-lime to-lime-moss bg-clip-text text-transparent"
        >
          la diferencia
        </span>
      </h2>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {
        benefits.map((benefit) => (
          <div class="group relative">
            <div class="absolute inset-0 bg-gradient-to-br from-lemon-lime/20 to-lime-moss/20 rounded-3xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
            <div class="relative bg-dark-khaki-2/40 backdrop-blur-xl rounded-3xl p-10 border border-lime-moss/20 hover:border-lime-moss/40 transition-all duration-300 transform hover:scale-105 text-center h-full">
              <div class="bg-gradient-to-br from-lemon-lime/10 to-lime-moss/10 rounded-2xl w-24 h-24 flex items-center justify-center mx-auto mb-6 border border-lime-moss/20">
                <span class="text-6xl">{benefit.icon}</span>
              </div>
              <div class="text-5xl font-bold font-sans bg-gradient-to-r from-lemon-lime to-lime-moss bg-clip-text text-transparent mb-2">
                {benefit.stat}
              </div>
              <div class="text-lime-moss text-sm font-semibold font-sans mb-4">
                {benefit.statLabel}
              </div>
              <h3 class="text-2xl font-serif font-bold mb-4 bg-gradient-to-r from-white to-gray-300 bg-clip-text text-transparent">
                {benefit.title}
              </h3>
              <p class="text-gray-400 leading-relaxed font-sans">
                {benefit.description}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
