---
const links = [
  { href: '/#producto', label: 'Producto' },
  { href: '/#como-funciona', label: 'Cómo funciona' },
  { href: '/blog/', label: 'Novedades' },
]
---

<header
  id="site-nav"
  class="fixed inset-x-0 top-0 z-50 border-b border-moss/15 bg-ink-950/85 backdrop-blur-md"
>
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 sm:px-8">
    <a href="/" class="group flex items-baseline gap-2" aria-label="Ticka — inicio">
      <span class="font-display text-2xl font-semibold italic tracking-tight text-paper">
        Ticka<span class="text-lime">.</span>
      </span>
      <span class="stamp -rotate-3 text-[10px] text-lime transition-transform duration-300 group-hover:rotate-0">
        Alfa
      </span>
    </a>

    <div class="hidden items-center gap-8 md:flex">
      {
        links.map((link) => (
          <a href={link.href} class="draw-link py-1 text-sm font-medium text-paper-dim hover:text-paper">
            {link.label}
          </a>
        ))
      }
      <a
        href="/#contacto"
        class="border border-lime bg-lime px-4 py-2 font-mono text-xs font-semibold tracking-[0.14em] text-ink-950 uppercase transition-colors duration-300 hover:bg-transparent hover:text-lime"
      >
        Unirme al alfa
      </a>
    </div>

    <button
      id="nav-toggle"
      type="button"
      class="flex h-10 w-10 flex-col items-center justify-center gap-1.5 md:hidden"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="nav-bar block h-px w-6 bg-paper transition-transform duration-300"></span>
      <span class="nav-bar block h-px w-6 bg-paper transition-opacity duration-300"></span>
      <span class="nav-bar block h-px w-6 bg-paper transition-transform duration-300"></span>
    </button>
  </nav>

  <div
    id="mobile-menu"
    class="hidden border-t border-moss/15 bg-ink-950/95 backdrop-blur-md md:hidden"
  >
    <div class="mx-auto flex max-w-6xl flex-col px-5 py-4 sm:px-8">
      {
        links.map((link, i) => (
          <a
            href={link.href}
            class="mobile-link flex items-baseline justify-between border-b border-moss/10 py-4 text-lg text-paper"
          >
            {link.label}
            <span class="font-mono text-xs text-paper-mute">0{i + 1}</span>
          </a>
        ))
      }
      <a
        href="/#contacto"
        class="mobile-link mt-5 mb-2 border border-lime bg-lime px-4 py-3 text-center font-mono text-sm font-semibold tracking-[0.14em] text-ink-950 uppercase"
      >
        Unirme al alfa
      </a>
    </div>
  </div>
</header>

<script>
  function initNav() {
    const toggle = document.getElementById('nav-toggle')
    const menu = document.getElementById('mobile-menu')
    if (!toggle || !menu) return

    const bars = toggle.querySelectorAll<HTMLElement>('.nav-bar')

    function setOpen(open: boolean) {
      menu!.classList.toggle('hidden', !open)
      toggle!.setAttribute('aria-expanded', String(open))
      toggle!.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú')
      bars[0]?.style.setProperty('transform', open ? 'translateY(6.5px) rotate(45deg)' : 'none')
      bars[1]?.style.setProperty('opacity', open ? '0' : '1')
      bars[2]?.style.setProperty('transform', open ? 'translateY(-6.5px) rotate(-45deg)' : 'none')
    }

    toggle.addEventListener('click', () => {
      setOpen(menu.classList.contains('hidden'))
    })

    menu.querySelectorAll('.mobile-link').forEach((link) => {
      link.addEventListener('click', () => setOpen(false))
    })
  }

  initNav()
  document.addEventListener('astro:page-load', initNav)
</script>
