---
const currentYear = new Date().getFullYear();
---

<footer
  class="relative bg-charcoal-brown pt-20 pb-10 overflow-hidden border-t border-lime-moss/20"
>
  <div
    class="absolute inset-0 bg-gradient-to-t from-charcoal-brown-2 to-charcoal-brown pointer-events-none"
  >
  </div>

  <div
    class="absolute inset-0 bg-[linear-gradient(rgba(170,180,74,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(170,180,74,0.03)_1px,transparent_1px)] bg-[size:50px_50px] opacity-50 pointer-events-none"
  >
  </div>

  <div
    class="absolute -bottom-40 left-1/2 -translate-x-1/2 w-[500px] h-[500px] bg-lime-moss rounded-full blur-3xl opacity-10 pointer-events-none"
  >
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
      <div class="space-y-6">
        <a href="/" class="text-2xl font-black tracking-tight">
          <span
            class="bg-gradient-to-r from-lemon-lime via-lime-moss to-lemon-lime bg-clip-text text-transparent"
          >
            Ticka
          </span>
        </a>
        <p class="text-gray-400 text-sm leading-relaxed">
          Automatización inteligente de facturas para contadores que valoran su
          tiempo. Deja que nosotros nos encarguemos del trabajo pesado.
        </p>
        <div class="flex space-x-4">
          <a
            href="#"
            class="text-gray-400 hover:text-lemon-lime transition-colors"
          >
            <span class="sr-only">Twitter</span>
            <svg
              class="h-6 w-6"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84"
              ></path>
            </svg>
          </a>
          <a
            href="#"
            class="text-gray-400 hover:text-lemon-lime transition-colors"
          >
            <span class="sr-only">LinkedIn</span>
            <svg
              class="h-6 w-6"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
                clip-rule="evenodd"></path>
            </svg>
          </a>
        </div>
      </div>

      <div>
        <h3 class="text-white font-semibold mb-6">Producto</h3>
        <ul class="space-y-4">
          <li>
            <a
              href="#"
              class="text-gray-400 hover:text-lemon-lime transition-colors text-sm"
              >Características</a
            >
          </li>
          <li>
            <a
              href="#"
              class="text-gray-400 hover:text-lemon-lime transition-colors text-sm"
              >Integraciones</a
            >
          </li>
          <li>
            <a
              href="#"
              class="text-gray-400 hover:text-lemon-lime transition-colors text-sm"
              >Precios</a
            >
          </li>
          <li>
            <a
              href="#"
              class="text-gray-400 hover:text-lemon-lime transition-colors text-sm"
              >Para Contadores</a
            >
          </li>
        </ul>
      </div>

