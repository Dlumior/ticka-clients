---
import { getCollection } from 'astro:content'
import FormattedDate from '../../components/FormattedDate.astro'
import Footer from '../../components/shared/Footer.astro'
import Navigation from '../../components/shared/Navigation.astro'
import MainLayout from '../../layouts/MainLayout.astro'

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)
---

<MainLayout
  title="Novedades — Ticka"
  description="Bitácora del alfa de Ticka: lo nuevo que estamos construyendo para automatizar los comprobantes de los estudios contables en el Perú."
>
  <Navigation />
  <main class="pt-16">
    <header class="ledger-lines border-b border-moss/15">
      <div class="mx-auto max-w-6xl px-5 pt-20 pb-14 sm:px-8 lg:pt-28">
        <p class="kicker mb-6" data-anim="blog-kicker">[ Bitácora del alfa ]</p>
        <h1
          class="font-display text-5xl leading-[1.05] font-medium tracking-tight text-paper sm:text-6xl"
          data-anim="blog-title"
        >
          Novedades<span class="text-lime">.</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-paper-dim" data-anim="blog-sub">
          Lo que vamos construyendo, contado sin humo: qué hay de nuevo en
          Ticka y qué viene después.
        </p>
      </div>
    </header>

    <section class="mx-auto max-w-6xl px-5 py-14 sm:px-8 lg:py-20">
      <ol class="border-t border-moss/15">
        {
          posts.map((post, i) => (
            <li class="border-b border-moss/15" data-anim="blog-entry">
              <a
                href={`/blog/${post.id}/`}
                class="group grid gap-3 py-9 transition-colors duration-300 sm:grid-cols-12 sm:gap-6"
              >
                <div class="sm:col-span-3 lg:col-span-2">
                  <span class="block font-mono text-xs tracking-[0.18em] text-paper-mute">
                    N° {String(posts.length - i).padStart(3, '0')}
                  </span>
                  <span class="mt-2 block font-mono text-xs text-moss">
                    <FormattedDate date={post.data.pubDate} />
                  </span>
                </div>
                <div class="sm:col-span-8 lg:col-span-9">
                  <h2 class="font-display text-2xl leading-snug font-medium text-paper transition-colors duration-300 group-hover:text-lime sm:text-3xl">
                    {post.data.title}
                  </h2>
                  <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-paper-dim">
                    {post.data.description}
                  </p>
                </div>
                <div class="hidden items-start justify-end sm:col-span-1 sm:flex">
                  <span class="font-mono text-lg text-paper-mute transition-all duration-300 group-hover:translate-x-1 group-hover:text-lime">
                    →
                  </span>
                </div>
              </a>
            </li>
          ))
        }
      </ol>

      {
        posts.length === 0 && (
          <p class="py-16 text-center font-mono text-sm text-paper-mute">
            Aún no hay publicaciones.
          </p>
        )
      }
    </section>
  </main>
  <Footer />
</MainLayout>

<script>
  import gsap from 'gsap'

  const mm = gsap.matchMedia()

  mm.add('(prefers-reduced-motion: no-preference)', () => {
    gsap
      .timeline({ defaults: { ease: 'power3.out' } })
      .from('[data-anim="blog-kicker"]', { y: 14, autoAlpha: 0, duration: 0.5 })
      .from('[data-anim="blog-title"]', { y: 26, autoAlpha: 0, duration: 0.8 }, '-=0.25')
      .from('[data-anim="blog-sub"]', { y: 22, autoAlpha: 0, duration: 0.7 }, '-=0.5')
      .from(
        '[data-anim="blog-entry"]',
        { y: 30, autoAlpha: 0, duration: 0.7, stagger: 0.1 },
        '-=0.4',
      )
  })
</script>
