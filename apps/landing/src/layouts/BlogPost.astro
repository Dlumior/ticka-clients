---
import type { CollectionEntry } from 'astro:content'
import FormattedDate from '../components/FormattedDate.astro'
import Footer from '../components/shared/Footer.astro'
import Navigation from '../components/shared/Navigation.astro'
import MainLayout from './MainLayout.astro'

type Props = CollectionEntry<'blog'>['data']

const { title, description, pubDate, updatedDate } = Astro.props
---

<MainLayout title={`${title} — Ticka`} description={description}>
  <Navigation />
  <main class="pt-16">
    <article>
      <header class="ledger-lines border-b border-moss/15">
        <div class="mx-auto max-w-3xl px-5 pt-20 pb-14 sm:px-8 lg:pt-28">
          <p class="mb-8">
            <a
              href="/blog/"
              class="draw-link font-mono text-xs tracking-[0.18em] text-paper-mute uppercase hover:text-paper"
            >
              ← Novedades
            </a>
          </p>
          <p class="kicker mb-6" data-anim="post-meta">
            <FormattedDate date={pubDate} />
          </p>
          <h1
            class="font-display text-4xl leading-[1.08] font-medium tracking-tight text-paper sm:text-5xl"
            data-anim="post-title"
          >
            {title}
          </h1>
          <p class="mt-6 text-lg leading-relaxed text-paper-dim" data-anim="post-desc">
            {description}
          </p>
          {
            updatedDate && (
              <p class="mt-6 font-mono text-xs tracking-[0.1em] text-paper-mute">
                Actualizado: <FormattedDate date={updatedDate} />
              </p>
            )
          }
        </div>
      </header>

      <div class="mx-auto max-w-3xl px-5 py-14 sm:px-8 lg:py-20">
        <div class="prose-ticka" data-anim="post-body">
          <slot />
        </div>

        <div class="mt-16 border-t border-moss/15 pt-10 text-center">
          <p class="font-mono text-xs tracking-[0.14em] text-paper-mute uppercase">
            ¿Quieres probar esto con tus propios comprobantes?
          </p>
          <a
            href="/#contacto"
            class="mt-5 inline-block border border-lime bg-lime px-7 py-3.5 font-mono text-sm font-semibold tracking-[0.14em] text-ink-950 uppercase transition-colors duration-300 hover:bg-transparent hover:text-lime"
          >
            Unirme al alfa
          </a>
        </div>
      </div>
    </article>
  </main>
  <Footer />
</MainLayout>

<script>
  import gsap from 'gsap'

  const mm = gsap.matchMedia()

  mm.add('(prefers-reduced-motion: no-preference)', () => {
    gsap
      .timeline({ defaults: { ease: 'power3.out' } })
      .from('[data-anim="post-meta"]', { y: 14, autoAlpha: 0, duration: 0.5 })
      .from('[data-anim="post-title"]', { y: 26, autoAlpha: 0, duration: 0.8 }, '-=0.25')
      .from('[data-anim="post-desc"]', { y: 22, autoAlpha: 0, duration: 0.7 }, '-=0.5')
      .from('[data-anim="post-body"]', { y: 24, autoAlpha: 0, duration: 0.8 }, '-=0.4')
  })
</script>
